{
  "name": "@bibit-internal/runtime-plugin",
  "version": "0.2.41",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:dev": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:adapter && npm run test:ui",
    "test:adapter": "python3 -m unittest discover -s tests -v",
    "keygen": "bibit-plugin keygen --out .bibit-keys --key-id runtime-development",
    "build:plugin": "bibit-plugin build --key .bibit-keys/runtime-development-private.pem --key-id runtime-development",
    "test:ui": "vitest run"
  },
  "bibitPlugin": {
    "entry": "src/plugin.tsx",
    "manifest": "bibit.feature.json",
    "artifactDir": "artifacts"
  },
  "dependencies": {
    "@bibit/feature-contracts": "file:vendor/bibit-feature-contracts-0.4.0.tgz",
    "@bibit/feature-dev-host": "file:vendor/bibit-feature-dev-host-0.4.0.tgz",
    "@bibit/feature-plugin-sdk": "file:vendor/bibit-feature-plugin-sdk-0.4.0.tgz",
    "@bibit/feature-sdk": "file:vendor/bibit-feature-sdk-0.4.0.tgz",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "jsdom": "^26.1.0",
    "typescript": "5.9.2",
    "vite": "6.1.0",
    "vitest": "^3.2.4"
  }
}
